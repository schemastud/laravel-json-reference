{
    "name": "schemastud/laravel-json-reference",
    "description": "A node-type-agnostic JSON reference/identity leaf: NodeId (@id) instance identity plus the base cross-engine reference vocabulary every engine's resolution primitive builds on. Like JSON Schema's $ref, its keywords are unprefixed and base-owned.",
    "keywords": ["laravel", "json", "reference", "identity", "json-ld", "dereference"],
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Schemastud\\JsonReference\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\JsonReference\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schemastud\\JsonReference\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
